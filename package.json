{
  "name": "old-growth",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A 2D web incremental/clicker game where the upgrade tree is a literal, procedurally drawn tree.",
  "scripts": {
    "analyze": "node scripts/analyze-bundle.mjs dist",
    "assets:icons": "node scripts/generate-icons.mjs",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs dist",
    "check:magic": "node scripts/check-magic-numbers.mjs",
    "deploy:vercel": "npx --yes vercel@latest deploy --prod",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "package:itch": "node scripts/package-itch.mjs",
    "preview": "vite preview",
    "sim": "vite-node scripts/sim/run.ts",
    "sim:trace": "vite-node scripts/sim/trace.ts",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "break_infinity.js": "^2.0.0",
    "howler": "^2.2.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.11.1",
    "@types/howler": "^2.2.11",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.2",
    "eslint": "^9.11.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.12",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.8.0",
    "vite": "^5.4.8",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.2"
  }
}
